generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum KfUserRole {
  PROVIDER
  ADMIN
}

enum KfListingStatus {
  DRAFT
  PUBLISHED
  DISABLED
}

enum KfModerationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum KfListingAssistanceStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  DECLINED
}

enum KfAnalyticsEventType {
  LISTING_IMPRESSION
  LISTING_VIEW
  LISTING_CLICK_WHATSAPP
  LISTING_CLICK_CALL
  LISTING_CLICK_DIRECTIONS
  LISTING_SHARE
  LISTING_NEARBY_SECTION_VIEW
  LISTING_DISCOVERY_CLICK
  SEARCH
  CATEGORY_BROWSE
}

model KfUser {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String?
  name         String?
  role         KfUserRole @default(PROVIDER)
  suspended    Boolean  @default(false)
  lastSeenAt   DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  listing         KfProviderListing?
  reviews         KfReview[]
  reports         KfReport[] @relation("Reporter")
  analyticsEvents KfAnalyticsEvent[]
  listingAssistanceRequests KfListingAssistanceRequest[]
  listingAssistanceStatusEvents KfListingAssistanceStatusEvent[] @relation("AssistanceStatusAdmin")
  listingAssistanceAuditEntries KfListingAssistanceAuditEntry[] @relation("AssistanceAuditAdmin")
  adminPushSubscriptions      KfAdminPushSubscription[]
  notificationPreferences     KfAdminNotificationPreference[]
  notificationSettings        KfAdminNotificationSettings?
  adminNotifications          KfAdminNotification[]
}

model KfCategory {
  id        String   @id @default(cuid())
  slug      String   @unique
  name      String
  parentId  String?
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  parent   KfCategory?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children KfCategory[] @relation("CategoryTree")
  listings KfListingCategory[]
  analyticsEvents KfAnalyticsEvent[]
}

model KfProviderListing {
  id               String   @id @default(cuid())
  userId           String   @unique
  displayName      String
  description      String   @db.Text
  phone            String
  whatsapp         String?
  latitude         Float
  longitude        Float
  locationLabel    String
  hideExactLocation Boolean @default(true)
  priceHint        String?
  hoursNote        String?
  status           KfListingStatus @default(DRAFT)
  moderationStatus KfModerationStatus @default(PENDING)
  profileImageUrl  String?
  featured         Boolean  @default(false)
  featuredAt       DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user       KfUser              @relation(fields: [userId], references: [id], onDelete: Cascade)
  categories KfListingCategory[]
  services   KfProviderService[]
  photos     KfProviderPhoto[]
  reviews    KfReview[]
  reports    KfReport[]
  analyticsEvents KfAnalyticsEvent[]
  assistanceRequests KfListingAssistanceRequest[]
  assistanceAuditEntries KfListingAssistanceAuditEntry[]
}

model KfListingCategory {
  listingId  String
  categoryId String

  listing  KfProviderListing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  category KfCategory        @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([listingId, categoryId])
}

model KfProviderService {
  id        String   @id @default(cuid())
  listingId String
  name      String
  keywords  String   @default("")
  createdAt DateTime @default(now())

  listing KfProviderListing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@index([listingId])
}

model KfProviderPhoto {
  id        String   @id @default(cuid())
  listingId String
  url       String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  listing KfProviderListing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@index([listingId])
}

model KfReview {
  id        String   @id @default(cuid())
  listingId String
  userId    String?
  authorName String?
  rating    Int
  body      String   @db.Text
  verified  Boolean  @default(false)
  hidden    Boolean  @default(false)
  createdAt DateTime @default(now())

  listing KfProviderListing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  user    KfUser?             @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([listingId])
}

model KfReport {
  id         String   @id @default(cuid())
  listingId  String?
  reviewId   String?
  reporterId String?
  reason     String
  details    String?  @db.Text
  resolved   Boolean  @default(false)
  createdAt  DateTime @default(now())

  listing  KfProviderListing? @relation(fields: [listingId], references: [id], onDelete: SetNull)
  reporter KfUser?            @relation("Reporter", fields: [reporterId], references: [id], onDelete: SetNull)
}

model KfListingAssistanceRequest {
  id              String                    @id @default(cuid())
  listingId       String
  userId          String
  providerMessage String?                   @db.Text
  status          KfListingAssistanceStatus @default(PENDING)
  adminNotes      String?                   @db.Text
  completedAt     DateTime?
  createdAt       DateTime                  @default(now())
  updatedAt       DateTime                  @updatedAt

  listing      KfProviderListing                 @relation(fields: [listingId], references: [id], onDelete: Cascade)
  user         KfUser                            @relation(fields: [userId], references: [id], onDelete: Cascade)
  statusEvents KfListingAssistanceStatusEvent[]
  auditEntries KfListingAssistanceAuditEntry[]

  @@index([status, createdAt])
  @@index([listingId])
  @@index([userId])
  @@index([createdAt])
}

model KfListingAssistanceStatusEvent {
  id         String                     @id @default(cuid())
  requestId  String
  fromStatus KfListingAssistanceStatus?
  toStatus   KfListingAssistanceStatus
  adminId    String
  note       String?                    @db.Text
  createdAt  DateTime                   @default(now())

  request KfListingAssistanceRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  admin   KfUser                     @relation("AssistanceStatusAdmin", fields: [adminId], references: [id], onDelete: Cascade)

  @@index([requestId, createdAt])
}

model KfListingAssistanceAuditEntry {
  id            String   @id @default(cuid())
  requestId     String
  listingId     String
  adminId       String
  fieldName     String
  previousValue String?  @db.Text
  newValue      String?  @db.Text
  createdAt     DateTime @default(now())

  request KfListingAssistanceRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  listing KfProviderListing        @relation(fields: [listingId], references: [id], onDelete: Cascade)
  admin   KfUser                   @relation("AssistanceAuditAdmin", fields: [adminId], references: [id], onDelete: Cascade)

  @@index([requestId, createdAt])
  @@index([listingId, createdAt])
}

model KfAdminAudit {
  id        String   @id @default(cuid())
  adminId   String
  action    String
  targetId  String?
  detail    String?  @db.Text
  createdAt DateTime @default(now())

  @@index([createdAt])
}

model KfAnalyticsEvent {
  id         String               @id @default(cuid())
  eventType  KfAnalyticsEventType
  listingId  String?
  categoryId String?
  userId     String?
  visitorId  String
  query      String?
  regionLabel String?
  createdAt  DateTime             @default(now())

  listing  KfProviderListing? @relation(fields: [listingId], references: [id], onDelete: SetNull)
  category KfCategory?        @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  user     KfUser?            @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([eventType, createdAt])
  @@index([listingId, createdAt])
  @@index([visitorId])
  @@index([createdAt])
  @@index([categoryId])
}

enum KfNotificationPriority {
  INFO
  IMPORTANT
  CRITICAL
}

enum KfAdminNotificationDeliveryStatus {
  PENDING
  IN_APP_ONLY
  PUSH_SENT
  PUSH_FAILED
  PUSH_SKIPPED
}

model KfPlatformEvent {
  id             String                 @id @default(cuid())
  eventType      String
  category       String
  priority       KfNotificationPriority
  metadata       Json?
  entityType     String?
  entityId       String?
  idempotencyKey String?                @unique
  createdAt      DateTime               @default(now())

  notifications KfAdminNotification[]

  @@index([eventType, createdAt])
  @@index([category, createdAt])
  @@index([entityType, entityId])
  @@index([createdAt])
}

model KfAdminPushSubscription {
  id            String    @id @default(cuid())
  adminId       String
  endpoint      String    @unique
  p256dh        String
  auth          String
  userAgent     String?
  deviceLabel   String?
  active        Boolean   @default(true)
  failureCount  Int       @default(0)
  lastSuccessAt DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  admin KfUser @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([adminId, active])
}

model KfAdminNotificationPreference {
  id           String  @id @default(cuid())
  adminId      String
  eventType    String
  pushEnabled  Boolean @default(false)
  inAppEnabled Boolean @default(true)

  admin KfUser @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@unique([adminId, eventType])
  @@index([adminId])
}

model KfAdminNotificationSettings {
  adminId           String  @id
  pushMasterEnabled Boolean @default(false)

  admin KfUser @relation(fields: [adminId], references: [id], onDelete: Cascade)
}

model KfAdminNotification {
  id              String                           @id @default(cuid())
  eventId         String
  adminId         String
  title           String
  body            String
  deepLink        String
  priority        KfNotificationPriority
  category        String
  readAt          DateTime?
  deliveryStatus  KfAdminNotificationDeliveryStatus @default(PENDING)
  pushAttemptedAt DateTime?
  createdAt       DateTime                         @default(now())

  event KfPlatformEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  admin KfUser        @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@unique([eventId, adminId])
  @@index([adminId, readAt, createdAt])
  @@index([adminId, createdAt])
}
