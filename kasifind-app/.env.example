# KasiFind standalone app — use ONE Postgres database for this service only.
DATABASE_URL="postgresql://user:pass@localhost:5432/kasifind?schema=public"
# Optional alias (same value as DATABASE_URL if you prefer the name):
# KASIFIND_DATABASE_URL="postgresql://..."

AUTH_SECRET="generate-with-openssl-rand-base64-32"
AUTH_URL="http://localhost:3000"
# Production custom domain — used for sitemaps, canonical URLs, and cookies when set:
# NEXT_PUBLIC_SITE_URL="https://kasifind.com"
# Canonical public origin for sitemap, Open Graph, and JSON-LD (production: https://kasifind.com).
# NEXT_PUBLIC_SITE_URL is preferred when set; AUTH_URL is used as fallback.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
# Production (Railway): mount a volume at /data and use this path so photos survive redeploys.
UPLOAD_DIR="/data/uploads"

KASIFIND_ADMIN_EMAIL="admin@example.com"
KASIFIND_ADMIN_PASSWORD="change-me-strong-password"
KASIFIND_ADMIN_NAME="Site admin"
