{
  "name": "kasifind",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "prisma generate && next build",
    "start": "node scripts/start.mjs",
    "lint": "eslint src",
    "test": "tsx --test src/lib/kasifind/__tests__/geo.test.ts src/lib/kasifind/__tests__/location-display.test.ts src/lib/kasifind/__tests__/whatsapp.test.ts src/lib/kasifind/__tests__/upload-asset.test.ts src/lib/kasifind/__tests__/upload-storage-status.test.ts src/lib/kasifind/__tests__/resolve-listing-image-src.test.ts src/lib/__tests__/standalone-boundary.test.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "node scripts/migrate-deploy.mjs",
    "db:seed": "npx tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "bcryptjs": "^3.0.3",
    "dotenv": "^17.4.2",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.35.0",
    "next": "16.3.3",
    "pg": "^8.23.0",
    "prisma": "^7.10.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.3",
    "tsx": "^4.21.0",
    "typescript": "^5"
  }
}
