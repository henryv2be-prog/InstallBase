# Local development
DATABASE_URL="postgresql://installbase:installbase@localhost:5432/installbase?schema=public"
AUTH_SECRET="installbase-dev-secret-change-in-production-2026"
AUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST="true"

# Legacy (still supported by NextAuth)
NEXTAUTH_URL="http://localhost:3000"

# Optional: Google OAuth (omit if not using)
# GOOGLE_CLIENT_ID=""
# GOOGLE_CLIENT_SECRET=""

# Web Push (phone alerts for messages / likes / follows)
# Generate with: npx web-push generate-vapid-keys
# Set these on the server (runtime). The public key is passed to Settings from the server,
# so it does not have to be present at `next build` time.
# NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
# VAPID_PUBLIC_KEY=""   # optional alias if you prefer not to use NEXT_PUBLIC_
# VAPID_PRIVATE_KEY=""
# VAPID_SUBJECT="mailto:hello@installbase.io"
UPLOAD_DIR="/data/uploads"

# --- Railway production ---
# Add a PostgreSQL plugin in Railway — then reference it on the web service:
#   DATABASE_URL = ${{Postgres.DATABASE_URL}}
#
# Required variables on the web service:
#   DATABASE_URL      — reference from Postgres plugin (see above)
#   AUTH_SECRET       — generate: openssl rand -base64 32
#   AUTH_URL          — https://${{RAILWAY_PUBLIC_DOMAIN}}
#   AUTH_TRUST_HOST   — true
#   PRISMA_HIDE_UPDATE_MESSAGE — true (optional, suppresses Prisma update banner)
#
# Migrations run automatically on container start (see scripts/migrate-deploy.mjs).
