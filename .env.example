# Local development
DATABASE_URL="postgresql://installbase:installbase@localhost:5432/installbase?schema=public"
AUTH_SECRET="installbase-dev-secret-change-in-production-2026"
AUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST="true"

# Legacy (still supported by NextAuth)
NEXTAUTH_URL="http://localhost:3000"

# Optional: Google OAuth (omit if not using)
# GOOGLE_CLIENT_ID=""
# GOOGLE_CLIENT_SECRET=""

# --- Railway production ---
# Add a PostgreSQL plugin in Railway — it injects DATABASE_URL automatically.
#
# Required variables on the web service:
#   AUTH_SECRET       — generate: openssl rand -base64 32
#   AUTH_URL          — https://${{RAILWAY_PUBLIC_DOMAIN}}
#   AUTH_TRUST_HOST   — true
#   NODE_ENV          — production (Railway sets this automatically)
#
# Optional one-time demo seed (wipes existing data):
#   railway run -e ALLOW_SEED=true npm run db:seed
