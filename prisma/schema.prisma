generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  USER
  ADMIN
}

enum PlatformRole {
  PROFESSIONAL
  COMPANY_REP
  EMPLOYER
  CUSTOMER
  SEEKING_WORK
}

enum ExperienceLevel {
  APPRENTICE
  ONE_TO_THREE
  THREE_TO_FIVE
  FIVE_TO_TEN
  TEN_PLUS
}

enum ReputationLevel {
  APPRENTICE
  INSTALLER
  EXPERIENCED
  PRO
  EXPERT
  MASTER
}

enum MemberTier {
  FOUNDING_MEMBER
  EARLY_BUILDER
}

enum PostType {
  POST
  BRAG
  QUESTION
  PROJECT
  VIDEO
}

enum VideoCompilationStatus {
  NONE
  QUEUED
  PROCESSING
  READY
  FAILED
}

enum PostMediaRole {
  SOURCE
  COMPILED
}

enum PostIntent {
  GENERAL
  PROJECT_INSTALLATION
  SERVICE_REPAIR
  PRODUCT_EQUIPMENT
  TRAINING_CERTIFICATION
  JOB_VACANCY
  LOOKING_FOR_WORK
  LOOKING_FOR_SUBCONTRACTORS
  LOOKING_FOR_PROFESSIONAL
}

enum EmploymentStatus {
  EMPLOYED
  SELF_EMPLOYED
  CONTRACTOR
  APPRENTICE
  STUDENT
  BETWEEN_JOBS
}

enum ReportReason {
  SPAM
  FAKE_ACCOUNT
  OFFENSIVE
  UNSAFE_ADVICE
  ADVERTISING
  OTHER
}

enum ReportStatus {
  PENDING
  REVIEWED
  RESOLVED
  DISMISSED
}

enum NotificationType {
  LIKE
  COMMENT
  FOLLOW
  MENTION
  ANSWER
  SOLUTION
  BRAG_RANKING
  PROJECT_COMMENT
  MESSAGE
  DAILY_REENGAGEMENT
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  emailVerified DateTime?
  passwordHash  String?
  name          String?
  image         String?
  role          UserRole  @default(USER)
  suspended     Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  lastSeenAt    DateTime?
  dailyDigestEnabled Boolean @default(true)
  lastDailyReengagementAt DateTime?

  accounts      Account[]
  sessions      Session[]
  profile       Profile?
  posts         Post[]
  comments      Comment[]
  bookmarks     Bookmark[]
  mediaBragPoints MediaBragPoint[]
  answers       Answer[]
  followers     Follow[]  @relation("Following")
  following     Follow[]  @relation("Follower")
  notifications Notification[] @relation("Recipient")
  actorNotifications Notification[] @relation("Actor")
  sentMessages  Message[] @relation("Sender")
  conversations ConversationParticipant[]
  reports       Report[]  @relation("Reporter")
  reportedUsers Report[]  @relation("ReportedUser")
  projects      Project[]
  reputation    Reputation?
  pushSubscriptions PushSubscription[]
  passwordResetTokens PasswordResetToken[]
  platformRoles     UserPlatformRole[]
  studyLearner      StudyLearner?
}

model UserPlatformRole {
  userId    String
  role      PlatformRole
  createdAt DateTime     @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, role])
  @@index([role])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Profile {
  id              String            @id @default(cuid())
  userId          String            @unique
  username        String            @unique
  bio             String?
  city            String?
  country         String?
  specialties     String[]
  experienceLevel ExperienceLevel   @default(APPRENTICE)
  reputationScore Int               @default(0)
  reputationLevel ReputationLevel   @default(APPRENTICE)
  verified        Boolean           @default(false)
  memberTier      MemberTier?
  bragCount       Int               @default(0)
  helpfulAnswers  Int               @default(0)
  coverImage              String?
  website                 String?
  openToWork              Boolean           @default(false)
  availableForContract    Boolean           @default(false)
  availableForSubcontract Boolean           @default(false)
  willingToTravel         Boolean           @default(false)
  serviceRadiusKm         Int?
  employmentStatus        EmploymentStatus?
  certifications          String[]
  createdAt               DateTime          @default(now())
  updatedAt               DateTime          @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([username])
  @@index([city, country])
  @@index([openToWork])
}

model Category {
  id          String   @id @default(cuid())
  name        String   @unique
  slug        String   @unique
  description String?
  icon        String?
  parentId    String?
  parent      Category? @relation("CategoryTree", fields: [parentId], references: [id])
  children    Category[] @relation("CategoryTree")
  posts       PostCategory[]
  brands      Brand[]
  createdAt   DateTime @default(now())
}

model Brand {
  id         String    @id @default(cuid())
  name       String    @unique
  slug       String    @unique
  logo       String?
  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id])
  products   Product[]
  createdAt  DateTime  @default(now())
}

model Product {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  brandId     String?
  brand       Brand?   @relation(fields: [brandId], references: [id])
  image       String?
  model       String?
  postProducts PostProduct[]
  createdAt   DateTime @default(now())

  @@index([name])
}

model Tag {
  id    String @id @default(cuid())
  name  String @unique
  slug  String @unique
  posts PostTag[]
}

model Post {
  id                String     @id @default(cuid())
  authorId          String
  type              PostType   @default(POST)
  postIntent        PostIntent @default(GENERAL)
  title             String?
  content           String
  location          String?
  workDate          DateTime?
  workDetails       Json?
  showExactLocation Boolean    @default(false)
  inPortfolio       Boolean    @default(false)
  solved            Boolean    @default(false)
  featured          Boolean    @default(false)
  bragScore         Int        @default(0)
  bragDetails       Json?
  viewCount         Int        @default(0)
  published         Boolean    @default(true)
  videoCompilationStatus VideoCompilationStatus @default(NONE)
  generatedVideoUrl      String?
  generatedVideoPosterUrl String?
  videoCompilationError  String?
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  author      User          @relation(fields: [authorId], references: [id], onDelete: Cascade)
  media       PostMedia[]
  comments    Comment[]
  bookmarks   Bookmark[]
  answers     Answer[]
  tags        PostTag[]
  products    PostProduct[]
  categories  PostCategory[]
  reports     Report[]

  @@index([authorId])
  @@index([type, createdAt])
  @@index([createdAt])
  @@index([authorId, inPortfolio, createdAt])
  @@index([postIntent, createdAt])
}

model PostMedia {
  id        String   @id @default(cuid())
  postId    String
  url       String
  type      String   @default("image")
  mediaRole PostMediaRole @default(SOURCE)
  caption   String?
  order     Int      @default(0)
  bragScore Int      @default(0)
  createdAt DateTime @default(now())

  post       Post             @relation(fields: [postId], references: [id], onDelete: Cascade)
  bragPoints MediaBragPoint[]

  @@index([postId])
}

model PostTag {
  postId String
  tagId  String
  post   Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  tag    Tag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([postId, tagId])
}

model PostProduct {
  postId    String
  productId String
  post      Post    @relation(fields: [postId], references: [id], onDelete: Cascade)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([postId, productId])
}

model PostCategory {
  postId     String
  categoryId String
  post       Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([postId, categoryId])
}

model Comment {
  id        String   @id @default(cuid())
  postId    String
  authorId  String
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  post   Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  author User @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([postId])
}

model Bookmark {
  id        String   @id @default(cuid())
  postId    String
  userId    String
  createdAt DateTime @default(now())

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
}

model MediaBragPoint {
  id          String   @id @default(cuid())
  postMediaId String
  userId      String
  createdAt   DateTime @default(now())

  postMedia PostMedia @relation(fields: [postMediaId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postMediaId, userId])
  @@index([postMediaId])
  @@index([userId])
}

model Answer {
  id         String   @id @default(cuid())
  postId     String
  authorId   String
  content    String
  helpful    Int      @default(0)
  isSolution Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  post   Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  author User @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([postId])
}

model Follow {
  id          String   @id @default(cuid())
  followerId  String
  followingId String
  createdAt   DateTime @default(now())

  follower  User @relation("Follower", fields: [followerId], references: [id], onDelete: Cascade)
  following User @relation("Following", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
  @@index([followerId])
  @@index([followingId])
}

model Project {
  id          String   @id @default(cuid())
  authorId    String
  title       String
  slug        String   @unique
  description String
  location    String?
  equipment   String[]
  challenges  String?
  solution    String?
  featured    Boolean  @default(false)
  likeCount   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  author User           @relation(fields: [authorId], references: [id], onDelete: Cascade)
  media  ProjectMedia[]

  @@index([authorId])
}

model ProjectMedia {
  id        String   @id @default(cuid())
  projectId String
  url       String
  type      String   @default("image")
  caption   String?
  order     Int      @default(0)

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  actorId   String?
  type      NotificationType
  message   String
  link      String?
  read      Boolean          @default(false)
  createdAt DateTime         @default(now())

  user  User  @relation("Recipient", fields: [userId], references: [id], onDelete: Cascade)
  actor User? @relation("Actor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([userId, read])
}

model Conversation {
  id           String   @id @default(cuid())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  participants ConversationParticipant[]
  messages     Message[]
}

model ConversationParticipant {
  id             String   @id @default(cuid())
  conversationId String
  userId         String
  joinedAt       DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
}

model Message {
  id             String   @id @default(cuid())
  conversationId String
  senderId       String
  content        String
  read           Boolean  @default(false)
  createdAt      DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation("Sender", fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId])
}

model Report {
  id             String       @id @default(cuid())
  reporterId     String
  reportedUserId String?
  postId         String?
  reason         ReportReason
  description    String?
  status         ReportStatus @default(PENDING)
  createdAt      DateTime     @default(now())

  reporter     User  @relation("Reporter", fields: [reporterId], references: [id], onDelete: Cascade)
  reportedUser User? @relation("ReportedUser", fields: [reportedUserId], references: [id], onDelete: SetNull)
  post         Post? @relation(fields: [postId], references: [id], onDelete: SetNull)

  @@index([status])
}

model Reputation {
  id              String          @id @default(cuid())
  userId          String          @unique
  score           Int             @default(0)
  level           ReputationLevel @default(APPRENTICE)
  helpfulAnswers  Int             @default(0)
  solvedQuestions Int             @default(0)
  bragEngagement  Int             @default(0)
  likesReceived   Int             @default(0)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Job {
  id          String   @id @default(cuid())
  title       String
  description String
  location    String
  category    String?
  requirements String?
  salary      String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([active, createdAt])
}

model BragOfWeek {
  id         String   @id @default(cuid())
  postId     String
  category   String
  weekStart  DateTime
  featured   Boolean  @default(true)
  createdAt  DateTime @default(now())

  @@unique([category, weekStart])
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ─── Advertising ───────────────────────────────────────────────────────────

enum AdType {
  IMAGE
  BANNER
  SPONSORED_POST
  SPONSORED_PRODUCT
  SPONSORED_ARTICLE
  VIDEO
}

enum AdStatus {
  DRAFT
  ACTIVE
  PAUSED
  ARCHIVED
}

enum CampaignStatus {
  DRAFT
  ACTIVE
  PAUSED
  ARCHIVED
  COMPLETED
}

enum PricingModel {
  CPM
  CPC
  FLAT_RATE
  MONTHLY
  PACKAGE
}

enum AdDeviceTarget {
  ALL
  MOBILE
  DESKTOP
  TABLET
}

enum AdEventType {
  IMPRESSION
  CLICK
}

model Advertiser {
  id           String   @id @default(cuid())
  name         String
  slug         String   @unique
  description  String?
  logoUrl      String?
  website      String?
  contactEmail String?
  contactPhone String?
  companyType  String?
  userId       String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  campaigns      AdCampaign[]
  advertisements Advertisement[]

  @@index([userId])
}

model AdInventory {
  id            String         @id @default(cuid())
  placementKey  String         @unique
  name          String
  description   String?
  format        String         @default("card")
  width         Int?
  height        Int?
  deviceSupport AdDeviceTarget @default(ALL)
  enabled       Boolean        @default(true)
  pricingConfig Json?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

model AdCampaign {
  id           String         @id @default(cuid())
  advertiserId String
  name         String
  description  String?
  status       CampaignStatus @default(DRAFT)
  pricingModel PricingModel?
  budget       Decimal?       @db.Decimal(12, 2)
  spent        Decimal        @default(0) @db.Decimal(12, 2)
  startDate    DateTime?
  endDate      DateTime?
  priority     Int            @default(0)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  advertiser     Advertiser      @relation(fields: [advertiserId], references: [id], onDelete: Cascade)
  advertisements Advertisement[]
  events         AdEvent[]
  dailyStats     AdDailyStats[]

  @@index([advertiserId])
  @@index([status, startDate, endDate])
}

model Advertisement {
  id                 String   @id @default(cuid())
  campaignId         String
  advertiserId       String
  title              String
  description        String?
  type               AdType
  placements         String[]
  status             AdStatus @default(DRAFT)
  mediaUrl           String?
  mediaType          String?
  destinationUrl     String
  ctaText            String?
  isInternalLink     Boolean  @default(false)
  sponsoredProductId String?
  sponsoredPostId    String?
  priority           Int      @default(0)
  impressions        Int      @default(0)
  clicks             Int      @default(0)
  uniqueImpressions  Int      @default(0)
  uniqueClicks       Int      @default(0)
  startDate          DateTime?
  endDate            DateTime?
  targetingRules     Json?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  campaign   AdCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  advertiser Advertiser @relation(fields: [advertiserId], references: [id], onDelete: Cascade)
  events     AdEvent[]
  dailyStats AdDailyStats[]

  @@index([campaignId])
  @@index([advertiserId])
  @@index([status])
  @@index([status, startDate, endDate])
}

model AdEvent {
  id              String      @id @default(cuid())
  advertisementId String
  campaignId      String
  placementKey    String
  eventType       AdEventType
  viewerKey       String?
  deviceType      String?
  createdAt       DateTime    @default(now())

  advertisement Advertisement @relation(fields: [advertisementId], references: [id], onDelete: Cascade)
  campaign      AdCampaign    @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([advertisementId, eventType, createdAt])
  @@index([campaignId, createdAt])
  @@index([placementKey, createdAt])
  @@index([viewerKey, advertisementId, eventType, createdAt])
}

model AdDailyStats {
  id                String   @id @default(cuid())
  advertisementId   String
  campaignId        String
  placementKey      String
  date              DateTime @db.Date
  impressions       Int      @default(0)
  clicks            Int      @default(0)
  uniqueImpressions Int      @default(0)
  uniqueClicks      Int      @default(0)

  advertisement Advertisement @relation(fields: [advertisementId], references: [id], onDelete: Cascade)
  campaign      AdCampaign    @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@unique([advertisementId, placementKey, date])
  @@index([campaignId, date])
}

model AdSettings {
  id                 String   @id @default("global")
  adsEnabled         Boolean  @default(true)
  sponsoredEnabled   Boolean  @default(true)
  analyticsEnabled   Boolean  @default(true)
  maxFeedAds         Int      @default(3)
  minPostsBetweenAds Int      @default(4)
  maxPageAds         Int      @default(5)
  mobileMaxFeedAds   Int      @default(2)
  desktopMaxFeedAds  Int      @default(3)
  defaultPriority    Int      @default(0)
  provider           String   @default("internal")
  updatedAt          DateTime @updatedAt
}

// ─── Page analytics ────────────────────────────────────────────────────────

model PageViewEvent {
  id         String   @id @default(cuid())
  pageKey    String
  viewerKey  String?
  deviceType String?
  createdAt  DateTime @default(now())

  @@index([pageKey, createdAt])
  @@index([viewerKey, pageKey, createdAt])
}

model PageViewDailyStats {
  id          String   @id @default(cuid())
  pageKey     String
  date        DateTime @db.Date
  views       Int      @default(0)
  uniqueViews Int      @default(0)

  @@unique([pageKey, date])
}

// ─── Grade 12 Study Coach (experimental — namespaced, additive) ─────────────

enum StudyQuestionType {
  MULTIPLE_CHOICE
}

enum StudyContentSourceKind {
  OFFICIAL_CURRICULUM
  OFFICIAL_PAST_PAPER
  PRACTICE
  PROTOTYPE
}

enum StudyPriorityBand {
  NEEDS_ATTENTION
  KEEP_PRACTISING
  ON_TRACK
}

model StudySubject {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  grade       Int      @default(12)
  description String?
  sortOrder   Int      @default(0)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  curricula       StudyCurriculum[]
  learnerSubjects StudyLearnerSubject[]
  questions       StudyQuestion[]
}

model StudyCurriculum {
  id            String                 @id @default(cuid())
  subjectId     String
  name          String
  sourceKind    StudyContentSourceKind
  sourceTitle   String?
  sourceUrl     String?
  versionLabel  String?
  isComplete    Boolean                @default(false)
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt

  subject StudySubject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  topics  StudyTopic[]

  @@index([subjectId])
}

model StudyTopic {
  id           String   @id @default(cuid())
  curriculumId String
  slug         String
  name         String
  sortOrder    Int      @default(0)
  importance   Float    @default(1)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  curriculum StudyCurriculum @relation(fields: [curriculumId], references: [id], onDelete: Cascade)
  subtopics  StudySubtopic[]

  @@unique([curriculumId, slug])
}

model StudySubtopic {
  id        String   @id @default(cuid())
  topicId   String
  slug      String
  name      String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  topic                StudyTopic                 @relation(fields: [topicId], references: [id], onDelete: Cascade)
  questions            StudyQuestion[]
  masteries            StudyMastery[]
  planItems            StudyPlanItem[]
  assessmentSessions   StudyAssessmentSession[]

  @@unique([topicId, slug])
}

model StudyLearner {
  id          String    @id @default(cuid())
  userId      String?   @unique
  displayName String
  grade       Int       @default(12)
  schoolYear  Int       @default(2026)
  onboardedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user                 User?                      @relation(fields: [userId], references: [id], onDelete: SetNull)
  subjects             StudyLearnerSubject[]
  masteries            StudyMastery[]
  questionAttempts     StudyQuestionAttempt[]
  assessmentSessions   StudyAssessmentSession[]
  planDays             StudyPlanDay[]
}

model StudyLearnerSubject {
  id             String   @id @default(cuid())
  learnerId      String
  subjectId      String
  currentMarkPct Float
  targetMarkPct  Float
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  learner   StudyLearner  @relation(fields: [learnerId], references: [id], onDelete: Cascade)
  subject   StudySubject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  exams     StudyExam[]
  planItems StudyPlanItem[]

  @@unique([learnerId, subjectId])
}

model StudyExam {
  id               String   @id @default(cuid())
  learnerSubjectId String
  examAt           DateTime @db.Date
  paperNumber      Int?
  durationMinutes  Int?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  learnerSubject StudyLearnerSubject @relation(fields: [learnerSubjectId], references: [id], onDelete: Cascade)

  @@index([learnerSubjectId, examAt])
}

model StudyMastery {
  id                 String             @id @default(cuid())
  learnerId          String
  subtopicId         String
  masteryPct         Float              @default(0)
  questionsAttempted Int                @default(0)
  questionsCorrect   Int                @default(0)
  lastPracticedAt    DateTime?
  confidencePct      Float?
  priorityScore      Float?
  priorityBand       StudyPriorityBand?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  learner  StudyLearner  @relation(fields: [learnerId], references: [id], onDelete: Cascade)
  subtopic StudySubtopic @relation(fields: [subtopicId], references: [id], onDelete: Cascade)

  @@unique([learnerId, subtopicId])
  @@index([learnerId])
}

model StudyQuestion {
  id              String                 @id @default(cuid())
  subjectId       String
  subtopicId      String
  type            StudyQuestionType      @default(MULTIPLE_CHOICE)
  difficulty      Int                    @default(3)
  prompt          String                 @db.Text
  options         Json
  correctOptionId String
  explanation     String?                @db.Text
  sourceKind      StudyContentSourceKind
  sourceLabel     String?
  sourceYear      Int?
  active          Boolean                @default(true)
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt

  subject  StudySubject           @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  subtopic StudySubtopic          @relation(fields: [subtopicId], references: [id], onDelete: Cascade)
  attempts StudyQuestionAttempt[]

  @@index([subtopicId, active])
  @@index([subjectId])
}

model StudyAssessmentSession {
  id          String    @id @default(cuid())
  learnerId   String
  subtopicId  String
  startedAt   DateTime  @default(now())
  completedAt DateTime?

  learner  StudyLearner           @relation(fields: [learnerId], references: [id], onDelete: Cascade)
  subtopic StudySubtopic          @relation(fields: [subtopicId], references: [id], onDelete: Cascade)
  attempts StudyQuestionAttempt[]

  @@index([learnerId, startedAt])
}

model StudyQuestionAttempt {
  id               String   @id @default(cuid())
  learnerId        String
  questionId       String
  sessionId        String?
  selectedOptionId String?
  isCorrect        Boolean
  attemptedAt      DateTime @default(now())

  learner  StudyLearner            @relation(fields: [learnerId], references: [id], onDelete: Cascade)
  question StudyQuestion           @relation(fields: [questionId], references: [id], onDelete: Cascade)
  session  StudyAssessmentSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)

  @@index([learnerId, attemptedAt])
  @@index([questionId])
}

model StudyPlanDay {
  id               String   @id @default(cuid())
  learnerId        String
  planDate         DateTime @db.Date
  availableMinutes Int
  generatedAt      DateTime @default(now())

  learner StudyLearner    @relation(fields: [learnerId], references: [id], onDelete: Cascade)
  items   StudyPlanItem[]

  @@unique([learnerId, planDate])
}

model StudyPlanItem {
  id               String  @id @default(cuid())
  planDayId        String
  learnerSubjectId String
  subtopicId       String
  allocatedMinutes Int
  sortOrder        Int     @default(0)
  notes            String?

  planDay        StudyPlanDay        @relation(fields: [planDayId], references: [id], onDelete: Cascade)
  learnerSubject StudyLearnerSubject @relation(fields: [learnerSubjectId], references: [id], onDelete: Cascade)
  subtopic       StudySubtopic       @relation(fields: [subtopicId], references: [id], onDelete: Cascade)

  @@index([planDayId, sortOrder])
}
